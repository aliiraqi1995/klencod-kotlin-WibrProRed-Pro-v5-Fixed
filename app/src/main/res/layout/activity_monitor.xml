<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- شريط علوي بنفس تصميم الواجهة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@color/surface_red_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher_arc" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="WIBR+ PRO RED"
                android:textColor="@color/text_white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/red_primary" />

        <!-- حالة الفحص ودائرة التحميل -->
        <TextView
            android:id="@+id/tvRunState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Test RUNNING..."
            android:textColor="@color/red_bright"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pbSpinner"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/red_bright" />

        <!-- معلومات الشبكة والباسورد الجاري -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/tvSsid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SSID: -"
                android:textColor="@color/red_bright"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBssid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="BSSID: -"
                android:textColor="@color/red_bright"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvEncryption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Encryption: -"
                android:textColor="@color/red_bright"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvPasswordTry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Password: -"
                android:textColor="@color/text_white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- خط فاصل واضح -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/red_primary" />

        <!-- مربع شفاف معزول من تحت الخط إلى نهاية المعلومات لتوضيح التفاصيل -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/bg_red_translucent_box"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Password:"
                    android:textColor="@color/red_bright"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvPassProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 of 0"
                    android:textColor="@color/red_bright"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Speed:"
                    android:textColor="@color/red_bright"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvSpeedInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 passwords/minute"
                    android:textColor="@color/red_bright"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Link status:"
                    android:textColor="@color/red_bright"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvLinkStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Disconnected"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Estimated time:"
                    android:textColor="@color/red_bright"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvEstimatedInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 hr, 0 min"
                    android:textColor="@color/red_bright"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Signal level:"
                    android:textColor="@color/red_bright"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvSignalInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0"
                    android:textColor="@color/red_bright"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- تحكم بالسرعة والوقت المتبقي وأزرار Pause / Stop -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_red_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/btnMonSpeedDec"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:backgroundTint="@color/red_primary"
                android:text="-"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMonSpeedLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Interval: 7s"
                android:textColor="@color/red_bright"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMonSpeedInc"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:backgroundTint="@color/red_primary"
                android:text="+"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPause"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="12dp"
            android:backgroundTint="@color/card_red"
            android:text="Pause"
            android:textColor="@color/red_bright"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
