<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- شريط علوي شبيه بالواجهة الكلاسيكية باللون الأحمر -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@color/surface_red_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher_arc" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="WIBR+ PRO RED"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHelp"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="HELP"
            android:textColor="@color/red_bright"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnExit"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="EXIT"
            android:textColor="@color/red_soft"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/red_primary" />

    <!-- زر إضافة شبكة في أعلى القائمة -->
    <Button
        android:id="@+id/btnAddNetwork"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:backgroundTint="@color/card_red"
        android:text="Add Network"
        android:textColor="@color/red_bright"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- قائمة الشبكات المضافة للمتابعة مع زر حذف لكل عنصر -->
    <ListView
        android:id="@+id/lvQueuedNetworks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@color/red_border"
        android:dividerHeight="1dp" />

</LinearLayout>
