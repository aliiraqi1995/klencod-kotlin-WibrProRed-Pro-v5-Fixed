<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tvScanSsid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SSID"
        android:textColor="@color/red_bright"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- شريط قوة الإشارة الأحمر شبيه بالصورة -->
    <ProgressBar
        android:id="@+id/pbSignalBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progress="50"
        android:progressBackgroundTint="@color/card_red"
        android:progressTint="@color/red_primary" />

    <TextView
        android:id="@+id/tvScanSecurity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="[WPA2-PSK-CCMP]"
        android:textColor="@color/red_soft"
        android:textSize="13sp" />

</LinearLayout>
